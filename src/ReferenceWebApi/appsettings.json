{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Azure": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}{NewLine}  {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AzureAppConfiguration": {
    "Endpoint": "",
    "SentinelKey": "ReferenceWebApi:Sentinel",
    "CacheExpiration": "00:05:00",
    "KeyFilter": "ReferenceWebApi:*",
    "LabelFilter": ""
  },
  "AzureKeyVault": {
    "VaultUri": "",
    "SecretPrefix": "ReferenceWebApi",
    "CacheExpiration": "00:30:00"
  },
  "Api": {
    "Title": "Reference Web API",
    "Version": "v1",
    "EnableSwagger": true
  },
  "AllowedHosts": "*"
}
