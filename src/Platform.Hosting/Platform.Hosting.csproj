<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Platform.Hosting</RootNamespace>

    <!-- Package metadata — update when publishing as internal NuGet -->
    <Description>
      Opinionated, reusable hosting configuration for .NET 8 Web APIs.
      Enforces a consistent configuration source ordering, middleware pipeline,
      Serilog bootstrap, and Azure integration across all services.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure App Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="7.3.0" />

    <!-- Azure Key Vault Configuration Provider -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />

    <!-- Azure Identity -->
    <PackageReference Include="Azure.Identity" Version="1.13.1" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />

    <!-- Health checks -->
    <PackageReference Include="AspNetCore.HealthChecks.AzureKeyVault.Secrets" Version="8.0.1" />
  </ItemGroup>

</Project>
